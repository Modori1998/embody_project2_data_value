{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "P2_G3_SEMANTIC_JSON_V0_2_CANDIDATE",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "motion_phase",
    "object_relation",
    "gripper_state",
    "event_assessment",
    "events",
    "evidence_frame_indices",
    "evidence_quality",
    "observation_note"
  ],
  "properties": {
    "motion_phase": {
      "type": "string",
      "enum": [
        "approach",
        "grasp",
        "lift",
        "transport",
        "place",
        "retract",
        "idle",
        "other",
        "uncertain"
      ]
    },
    "object_relation": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "gripper_around",
          "gripper_contact_visible",
          "moving_with_gripper",
          "object_static",
          "object_not_visible",
          "uncertain"
        ]
      }
    },
    "gripper_state": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "partially_open",
        "uncertain"
      ]
    },
    "event_assessment": {
      "type": "string",
      "enum": [
        "event_visible",
        "no_event_visible",
        "insufficient_evidence"
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_type",
          "event_outcome",
          "evidence_frame_indices"
        ],
        "properties": {
          "event_type": {
            "type": "string",
            "enum": [
              "grasp_attempt",
              "release_attempt",
              "object_motion"
            ]
          },
          "event_outcome": {
            "type": "string",
            "enum": [
              "success",
              "failure",
              "unclear"
            ]
          },
          "evidence_frame_indices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer"
            }
          }
        }
      }
    },
    "evidence_frame_indices": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "evidence_quality": {
      "type": "string",
      "enum": [
        "sufficient",
        "partial",
        "insufficient"
      ]
    },
    "observation_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    }
  }
}